import bpy
import bmesh

def create_wall(name,location,scale):
    wall = bmesh.new()
    bmesh.ops.create_cube(wall,size = 1)

    wall_mesh = bpy.data.meshes.new(f"{name}")
    wall.to_mesh(wall_mesh)
    wall_mesh.update()

    wall_obj = bpy.data.objects.new(f"{name}",wall_mesh)
    bpy.context.collection.objects.link(wall_obj)

    wall_obj.location = location
    wall_obj.scale = scale
    wall.free()
    return wall_obj

