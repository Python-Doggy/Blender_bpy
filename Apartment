import bpy
import bmesh
import math

def create_wall(name,location,scale):
    wall = bmesh.new()
    bmesh.ops.create_cube(wall,size = 1)

    wall_mesh = bpy.data.meshes.new(f"{name}")
    wall.to_mesh(wall_mesh)
    wall_mesh.update()

    wall_obj = bpy.data.objects.new(f"{name}",wall_mesh)
    bpy.context.collection.objects.link(wall_obj)

    wall_obj.location = location
    wall_obj.scale = scale
    wall.free()
    return wall_obj

def create_windows(name,location,scale,rotation_euler):
    windows_plane = bmesh.new()
    bmesh.ops.create_grid(windows_plane , size = 1)

    windows_plane_mesh = bpy.data.meshes.new(f"{name}")
    windows_plane.to_mesh(windows_plane_mesh)
    windows_plane_mesh.update()

    windows_plane_obj = bpy.data.objects.new(f"{name}" , windows_plane_mesh)
    bpy.context.collection.objects.link(windows_plane_obj)

    windows_plane_obj.location = location
    windows_plane_obj.scale = scale
    windows_plane_obj.rotation_euler = rotation_euler
    windows_plane.free()
    return windows_plane_obj

